image:
  repository: "{{ requiredEnv "DOCKER_REGISTRY" }}/{{ requiredEnv "DOCKER_REGISTRY_ORG" }}/{{ requiredEnv "APP_NAME" }}"
  tag: "{{ requiredEnv "VERSION" }}"

replicaCount: 1

# jxRequirements override for preview
jxRequirements:
  ingress:
    namespaceSubDomain: "-pr{{ requiredEnv "PULL_NUMBER" }}."

config:
  cluster: '{{ env "CLUSTER_ID" | default "" }}'
  logLevel: debug

# C1 (auth hardening) preview wiring — MUST NOT run AUTH_REQUIRED=false
# even in preview. Preview pods run fail-closed with a placeholder issuer;
# go-common's ServiceClient constructor tolerates an unreachable JWKS
# (keyfunc/v3 does lazy background refresh with NoErrorReturnFirstHTTPReq),
# so the pod boots 1/1 and /health/live is served on the bypass path.
# Any request to /api/v1/* is rejected 401 because the JWKS never
# resolves — the exact fail-closed signal C1 requires. Mirrors the
# orch/agent/mcp preview fix.
#
# `clientSecret` MUST be non-empty here: go-common v1.0.0
# NewServiceClient rejects construction when any of ServerURL /
# ClientID / ClientSecret / Audience is empty, so without a literal
# the pod crash-loops on boot and /health/live never returns 3× 200 →
# end2end task times out at 10 min. The literal is a throwaway
# placeholder — client_credentials against the placeholder issuer
# 404s and no real token is ever minted. The chart's templates/auth-secret.yaml
# renders a k8s Secret from this literal so deployment.yaml's
# secretKeyRef resolves. In staging/production this value MUST be
# empty; a per-cluster ExternalSecret provides the real credential
# under the same k8s Secret name.
auth:
  required: true
  issuer: "https://hydra.preview-default.invalid"
  clientId: "preview-catalog-mcp"
  clientSecret: "preview-throwaway-not-a-real-credential"
  audience: "leartech-catalog-mcp"

# Looser resources for previews
resources:
  requests:
    cpu: 50m
    memory: 64Mi
  limits:
    memory: 256Mi
