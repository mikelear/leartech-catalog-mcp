image:
  repository: "{{ requiredEnv "DOCKER_REGISTRY" }}/{{ requiredEnv "DOCKER_REGISTRY_ORG" }}/{{ requiredEnv "APP_NAME" }}"
  tag: "{{ requiredEnv "VERSION" }}"

replicaCount: 1

# jxRequirements override for preview
jxRequirements:
  ingress:
    namespaceSubDomain: "-pr{{ requiredEnv "PULL_NUMBER" }}."

config:
  cluster: '{{ env "CLUSTER_ID" | default "" }}'
  logLevel: debug

# Previews run with REAL auth, pointed at the cluster's own Hydra.
#
# They already ran auth-on, which was right — but against a placeholder issuer
# (hydra.preview-default.invalid) that never resolves. keyfunc tolerates an
# unreachable JWKS via lazy background refresh, so the pod booted 1/1 and every
# /api/v1 request 401'd. That is a fail-closed posture, and the 401 proved the
# JWKS was unreachable rather than that token validation works.
#
# There is no reason for the placeholder: a Verifier needs an issuer and an
# audience, both PUBLIC, and the cluster's Hydra is reachable from a preview
# namespace on that cluster. With a real issuer the same 401 now means "a
# configured verifier refused an anonymous caller", which is the production
# contract.
#
# Host is hydra-jx-staging.<domain>, verified on both clusters
# (jx.leartech.com and az.leartech.com); the domain comes from jx-values.yaml,
# which `jx preview create` populates per cluster.
#
# `auth.required` is gone with the flag — auth is unconditional.
{{- $domain := .Values.jxRequirements.ingress.domain | default "" }}
{{- if not $domain }}
{{- fail "preview: jxRequirements.ingress.domain is empty, so the Hydra issuer cannot be derived. The chart marks auth.issuer required — fix jx-values.yaml rather than disabling auth." }}
{{- end }}
auth:
  issuer: 'https://hydra-jx-staging.{{ $domain }}'
  audience: "leartech-catalog-mcp"

# Looser resources for previews
resources:
  requests:
    cpu: 50m
    memory: 64Mi
  limits:
    memory: 256Mi
